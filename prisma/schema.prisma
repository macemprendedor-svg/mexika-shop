// Fase 1: captura de pedido, pausa de confirmación, filtro de cantidad.
// Postgres (Supabase) — necesario para persistir entre invocaciones
// serverless en Netlify (SQLite no sobrevive ahí).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Configuración editable desde el panel sin necesitar un redeploy (ej. el
// correo de soporte de Dropi, que puede cambiar antes de tener uno fijo).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING_CONFIRMATION // esperando correo1/correo2/sms
  CONFIRMED // el cliente confirmó, pendiente de pasar el filtro de cantidad
  QUANTITY_REVIEW // 2-3 unidades: requiere revisión humana antes de Dropi
  BLOCKED_QUANTITY // más de 3 unidades: bloqueado (redundancia server-side)
  SENT_TO_DROPI // orderMarkAsPaid ejecutado; Dropify lo recoge en su próximo ciclo
  PAUSED_ZONE_BLOCKED // el CP/transportadora está bloqueado por rechazos falsos previos
  CANCELLED_NOT_CONFIRMED // nunca confirmó tras el SMS -> historial 4.1
  CANCELLED_MANUAL // cancelado a mano (vendedor, o rechazo en revisión de cantidad)
  CANCELLED_DELIVERY_INCIDENT // no respondió la encuesta de entrega cuestionada a tiempo
}

enum ConfirmationChannel {
  EMAIL
  SMS
  MANUAL // reingresado desde el historial de no confirmados (sección 4.1)
}

model Order {
  id        String @id @default(cuid())
  shopifyOrderId String @unique // gid://shopify/Order/...
  shopifyOrderName String // "#1001"

  customerEmail String?
  customerPhone String?
  totalQuantity Int

  // Para la página de confirmación del cliente (sección 10): total a pagar,
  // dirección y productos. Se guardan tal cual vienen del webhook.
  totalPrice        String
  currency          String
  shippingAddressJson String? // JSON crudo de shipping_address
  lineItemsJson       String // JSON crudo de line_items (título, cantidad, precio)

  status OrderStatus @default(PENDING_CONFIRMATION)

  // Hora real de creación del pedido en Shopify (usada para las ventanas de confirmación)
  shopifyCreatedAt DateTime

  scheduledEmail2At DateTime
  scheduledSmsAt    DateTime
  email1SentAt      DateTime?
  email2SentAt      DateTime?
  smsSentAt         DateTime?

  confirmationToken           String    @unique
  confirmationTokenExpiresAt  DateTime
  confirmedAt                 DateTime?
  confirmedVia                ConfirmationChannel?

  quantityFilterResult   String? // AUTO_APPROVE | NEEDS_REVIEW | BLOCKED
  quantityReviewDecision String? // APPROVED | REJECTED
  quantityReviewDecidedAt DateTime?
  quantityReviewDecidedBy String?

  markedPaidAt DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  rawPayload String // JSON del webhook orders/create, para auditoría

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory OrderStatusHistory[]
  deliveryIncidents DeliveryIncident[]

  @@index([status])
  @@index([customerEmail])
  @@index([customerPhone])
}

model OrderStatusHistory {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus String?
  newStatus      String
  source         String // "webhook" | "cron" | "customer" | "admin:<email>"
  note           String?
  createdAt      DateTime @default(now())

  @@index([orderId])
}

// ============================================================
// Detección de rechazos falsos (módulo aparte, capa de investigación
// antes de construir la lógica de detección real sobre datos de verdad).
// ============================================================

// Captura cruda de cada fulfillment event que llega de Shopify, sin
// clasificar todavía. Sirve para ver qué manda Dropify realmente antes de
// decidir cómo detectar un "rechazo sospechoso" (sección 6 del spec).
model FulfillmentEventLog {
  id                       String   @id @default(cuid())
  shopifyFulfillmentEventId String  @unique // gid del FulfillmentEvent
  shopifyFulfillmentId     String? // gid del Fulfillment padre
  shopifyOrderId           String? // gid de la orden, si se pudo resolver
  status                   String? // valor crudo (ej. "FAILURE", "ATTEMPTED_DELIVERY")
  message                  String? // texto libre del carrier, si lo hay
  rawPayload               String // JSON completo del webhook, para inspección manual
  createdAt                DateTime @default(now())
}

enum DeliveryIncidentVerdict {
  REJECTED_FALSE // el cliente dice que nadie llegó -> cuenta para bloqueo de zona
  REJECTED_BY_CUSTOMER // sí llegaron, el cliente ya no lo quiso -> no se reporta a Dropi
  CANCELLED_NO_RESPONSE // no respondió la encuesta a tiempo -> no cuenta para bloqueo
}

enum DeliveryIncidentSurveyAnswer {
  NOBODY_CAME
  DELIVERED_BUT_REFUSED
  OTHER
}

// Un incidente = un intento de entrega sospechoso ya confirmado como tal
// (no cada fulfillment event crudo). Dispara la encuesta al cliente.
model DeliveryIncident {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  trackingNumber String? // guía
  carrierName    String? // transportadora
  postalCode     String
  municipality   String?

  rawStatus  String?
  rawMessage String?

  customerEmail String?
  customerPhone String?

  emailSentAt         DateTime?
  smsSentAt           DateTime?
  surveyToken         String    @unique @default(cuid())
  surveyRespondedAt   DateTime?
  surveyAnswer        DeliveryIncidentSurveyAnswer?
  surveyComment       String?
  verdict             DeliveryIncidentVerdict?

  reportedToDropiAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postalCode, carrierName])
  @@index([carrierName])
  @@index([orderId])
}

// Bloqueo activo de una zona (CP), una transportadora, o la combinación de
// ambas. postalCode = null significa "cualquier CP"; carrierName = null
// significa "cualquier transportadora".
model BlockedZone {
  id                 String   @id @default(cuid())
  postalCode         String?
  municipality       String?
  carrierName        String?
  reason             String
  incidentsReference Int
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  reactivatedAt      DateTime?
  reactivatedBy      String?

  @@index([postalCode, carrierName])
}
