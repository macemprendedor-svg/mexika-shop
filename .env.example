# Shopify Admin API — Dev Dashboard app (client credentials grant, vigente desde ene 2026)
# El backend intercambia client_id + client_secret por un access_token temporal (24h),
# no hay un token estático shpat_ que copiar desde la UI.
SHOPIFY_STORE_DOMAIN=mitienda.myshopify.com
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-07

# Base de datos (Supabase Postgres, connection string del "Session pooler" —
# IPv4, necesaria para conectar desde redes sin salida IPv6, y persistente
# entre invocaciones serverless a diferencia de SQLite). NO agregar
# ?sslmode=require aquí: el runtime fuerza TLS en código (lib/db.ts) con
# rejectUnauthorized:false por el certificado del pooler de Supabase; combinar
# ambos genera un conflicto de configuración SSL.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:TU_PASSWORD@aws-0-tu-region.pooler.supabase.com:5432/postgres"

# App pública (para links de confirmación por correo/SMS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Correo transaccional (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=pedidos@tudominio.com

# SMS transaccional (smsmasivos.com.mx)
SMSMASIVOS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMSMASIVOS_SANDBOX=1

# Protege /api/cron/process-confirmations y /api/cron/process-incident-surveys
CRON_SECRET=

# Telegram (solo alertas admin — zonas/transportadoras bloqueadas)
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_TELEGRAM_CHAT_ID=

# Reporte de rechazos falsos a Dropi
DROPI_SOPORTE_EMAIL=soporte@dropi.mx
